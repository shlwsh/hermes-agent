{
  "name": "hermes-agent",
  "version": "1.0.0",
  "description": "An AI agent with advanced tool-calling capabilities, featuring a flexible toolsets system for organizing and managing tools.",
  "private": true,
  "scripts": {
    "postinstall": "echo '✅ Browser tools ready. Run: python run_agent.py --help'",
    "mygit": "source venv/bin/activate && python3 scripts/mygit.py",
    "mygit:full": "source venv/bin/activate && python3 scripts/mygit.py",
    "hermes": "source venv/bin/activate && hermes",
    "chat": "source venv/bin/activate && hermes chat",
    "config": "source venv/bin/activate && hermes config",
    "skills": "source venv/bin/activate && hermes skills"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NousResearch/Hermes-Agent.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NousResearch/Hermes-Agent/issues"
  },
  "homepage": "https://github.com/NousResearch/Hermes-Agent#readme",
  "dependencies": {
    "agent-browser": "^0.13.0",
    "@askjo/camoufox-browser": "^1.0.0"
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
